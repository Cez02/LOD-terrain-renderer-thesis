#version 460

// Setup

#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_control_flow_attributes: require

#extension GL_EXT_mesh_shader : enable

#extension GL_EXT_shader_16bit_storage : require

#extension GL_EXT_shader_explicit_arithmetic_types_int8  : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require


#extension GL_EXT_shader_atomic_int64 : require

#extension GL_EXT_control_flow_attributes: require
#define UNROLL_LOOP [[unroll]]

#include "common.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(max_vertices=MAX_MESH_OUTPUT_VERTICES, max_primitives=MAX_MESH_OUTPUT_PRIMITIVES) out;
layout(triangles) out;




// SSBOs

layout(std430, binding = 0) readonly buffer HeightmapData {
    int16_t m_Heights[];
} heightmapData;

#ifdef ENCODED_MESHLETS

    layout(std430, binding = 1) readonly buffer MeshletDescriptions {
        EncodedMeshletDescription descriptions[];
    } meshletDescriptions;

#else

    layout(std140, binding = 1) readonly buffer MeshletDescriptions {
        MeshletDescription descriptions[];
    } meshletDescriptions;

#endif


struct RenderStatistics
{
    uint64_t PrimitiveCount;
    uint64_t TaskShaderInvocations;
    uint64_t MeshShaderInvocations;

};

layout(std430, binding = 2) writeonly buffer RenderStats {
    RenderStatistics statistics;
} renderStatistics;

shared uint meshShaderInvocations;



// Push constants

layout( push_constant ) uniform constants
{
	mat4 transform_matrix;
} PushConstants;






// Task shader input

struct Task {
    //     (meshletInfoBufferOffset, meshletCount)
    u16vec2 meshletClusterDescriptions[MESHLETS_PER_TASK_INVOCATION * MAX_PREFERRED_TASK_WORK_GROUP_INVOCATIONS + 2];
    //     (meshletDelta, LODLevel)
    u16vec2 meshletInfoBuffer[MESHLETS_PER_TASK_INVOCATION * MAX_PREFERRED_TASK_WORK_GROUP_INVOCATIONS + 2];

    uint meshletClusterDescriptionsCount;
    uint meshletInfoBufferCount;

    uint   baseMeshletID;
    uint    heightmapLength;

    float Longitude;
    float Latitude;

    vec3 observatorPosition;

    uint globalMeshletCount, localMeshletOffsetsCount;
};

taskPayloadSharedEXT Task IN;

// Indexing stuff

uint meshletClusterDescriptionOffset = gl_WorkGroupID.x;

uint localMeshletOffset = 0;
uint meshletTaskBufferOffset = 0;
uint globalMeshletID = 0;


uint quadID;

// General data

uint LOD_LEVEL = 1;
u16vec2 thisMeshletClusterDescription = u16vec2(0, 0);



// Output

layout(location=0) out Interpolants {
    vec3  wPos;
    float   wHeight;
    flat  uint meshletID;
} OUT[];


// Utils


void processVertex(uvec2 vertexOffset, uint meshletID, MeshletDescription meshlet, uint vertexIndexOffset, inout bool cull, uint vertIndex){

    uint heightmapIndex = meshlet.HeightmapDataOffset + vertexOffset.x + meshlet.Dimensions.x * vertexOffset.y;
    float height = float(int(heightmapData.m_Heights[heightmapIndex]));

    vec3 vertPos = vertexToPolarToCartesian(meshlet.Offset + vertexOffset, IN.Latitude, IN.Longitude, height, IN.heightmapLength);

    OUT[vertIndex].wPos = vertPos;
    OUT[vertIndex].wHeight = height;

    gl_MeshVerticesEXT[vertIndex].gl_Position = PushConstants.transform_matrix * vec4(vertPos, 1.0);

    float observerHorizonDistance = observerHorizonDistance(IN.observatorPosition);
    cull = cull && (observerHorizonDistance < length(vertPos - IN.observatorPosition));
}

shared uint vertCount;
shared uint primCount;

void main() {

    primCount = 0;
    vertCount = 0;
    meshShaderInvocations = 0;


    memoryBarrierShared();
    barrier();


    bool skip = meshletClusterDescriptionOffset >= IN.meshletClusterDescriptionsCount;

    thisMeshletClusterDescription = IN.meshletClusterDescriptions[meshletClusterDescriptionOffset];

    LOD_LEVEL = IN.meshletInfoBuffer[thisMeshletClusterDescription.x].y;




    // we jump the meshletClusters meshlets according to the LOD.
    // LOD-8 = every invocation ID
    // LOD-4 = every 4 invocation IDs...
    // LOD-2 = every 16 invocation IDs...
    // LOD-1 = every 64 invocation IDs...

    uint invocJump = ( 1 << (2 * (3 - int(log2(float(LOD_LEVEL))))) );

    localMeshletOffset = uint(gl_LocalInvocationID.x / invocJump);
    meshletTaskBufferOffset = uint(thisMeshletClusterDescription.x) + localMeshletOffset;
    quadID = gl_LocalInvocationID.x % invocJump;


    skip = skip || (localMeshletOffset >= thisMeshletClusterDescription.y);

    globalMeshletID = IN.baseMeshletID + uint(IN.meshletInfoBuffer[meshletTaskBufferOffset].x);

    skip = skip || (globalMeshletID >= IN.globalMeshletCount);


    atomicAdd(meshShaderInvocations, 1);


    // Quad calculations

    uint lodSideLength = (MESHLET_LENGTH - 1) / LOD_LEVEL;
    uvec2 quadOffset = uvec2 (quadID % (lodSideLength), (quadID / (lodSideLength)));


    MeshletDescription thisMeshlet = meshletDescriptions.descriptions[globalMeshletID];


    bool cull = true;


    if(!skip){
        // Prepare vertices

        uint vertAIndex = atomicAdd(vertCount, 4);
        uint    vertBIndex = vertAIndex + 1;
        uint    vertCIndex = vertAIndex + 2;
        uint    vertDIndex = vertAIndex + 3;

        uint quadStride = LOD_LEVEL;

        processVertex(LOD_LEVEL * quadOffset,                                   globalMeshletID, thisMeshlet, 0, cull, vertAIndex);
        processVertex(LOD_LEVEL * quadOffset + uvec2(quadStride, 0),            globalMeshletID, thisMeshlet, 0, cull, vertBIndex);
        processVertex(LOD_LEVEL * quadOffset + uvec2(0, quadStride),            globalMeshletID, thisMeshlet, 0, cull, vertCIndex);
        processVertex(LOD_LEVEL * quadOffset + uvec2(quadStride, quadStride),   globalMeshletID, thisMeshlet, 0, cull, vertDIndex);

        OUT[vertAIndex].meshletID = globalMeshletID;
        OUT[vertBIndex].meshletID = globalMeshletID;
        OUT[vertCIndex].meshletID = globalMeshletID;
        OUT[vertDIndex].meshletID = globalMeshletID;

        // Prepare primitives

        uint primID = atomicAdd(primCount, 2);

        uvec4 verts = uvec4(vertAIndex, vertBIndex, vertCIndex, vertDIndex);

        gl_PrimitiveTriangleIndicesEXT[primID] = uvec3(verts.y, verts.z, verts.x);
        gl_PrimitiveTriangleIndicesEXT[primID + 1] = uvec3(verts.z, verts.y, verts.w);

        gl_MeshPrimitivesEXT[primID].gl_CullPrimitiveEXT = cull;
        gl_MeshPrimitivesEXT[primID + 1].gl_CullPrimitiveEXT = cull;

        gl_MeshPrimitivesEXT[primID].gl_PrimitiveID = int(2*quadID);
        gl_MeshPrimitivesEXT[primID + 1].gl_PrimitiveID = int(2*quadID + 1);
    }


    memoryBarrierShared();
    barrier();

    SetMeshOutputsEXT(vertCount, primCount);

    // Statistics
    if(gl_LocalInvocationID.x == 0){
        atomicAdd(renderStatistics.statistics.PrimitiveCount, primCount);
        atomicAdd(renderStatistics.statistics.MeshShaderInvocations, meshShaderInvocations);
    }
}