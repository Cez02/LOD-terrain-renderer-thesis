#version 460

// Setup

#extension GL_GOOGLE_include_directive : enable

#extension GL_EXT_shader_atomic_int64 : require

#extension GL_EXT_shader_16bit_storage : require

#extension GL_EXT_shader_explicit_arithmetic_types_int8  : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#extension GL_EXT_mesh_shader : require

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_control_flow_attributes: require
#define UNROLL_LOOP [[unroll]]


#include "common.h"

layout(local_size_x = MAX_PREFERRED_TASK_WORK_GROUP_INVOCATIONS, local_size_y = 1, local_size_z = 1) in;

// Push constants

layout( push_constant ) uniform constants
{
    layout (offset = 64)  vec3 ObservatorPosition;
    int padding;
     vec3 ObserverLookingDirection;
    uint16_t MeshletCount;
    uint16_t HeightmapLength;
    uint BaseMeshletOffset;
    float Longitude;
    float Latitude;
    uint8_t LODLevel;

} PushConstants;

// SSBOs

layout(std430, binding = 0) readonly buffer HeightmapData {
    int16_t m_Heights[];
} heightmapData;

#ifdef ENCODED_MESHLETS

    layout(std430, binding = 1) readonly buffer MeshletDescriptions {
        EncodedMeshletDescription descriptions[];
    } meshletDescriptions;

#else

    layout(std140, binding = 1) readonly buffer MeshletDescriptions {
        MeshletDescription descriptions[];
    } meshletDescriptions;

#endif

struct RenderStatistics
{
    uint64_t PrimitiveCount;
    uint64_t TaskShaderInvocations;
    uint64_t MeshShaderInvocations;

};

layout(std430, binding = 2) writeonly buffer RenderStats {
    RenderStatistics statistics;
} renderStatistics;

shared int taskShaderInvocations;

// Indexing stuff

uint baseID = gl_WorkGroupID.x;
uint laneID = gl_LocalInvocationID.x;



// Utils

uint LOD_LEVEL;



// Task payload

#define TASK_ITERATIONS MAX_PREFERRED_MESH_WORK_GROUP_INVOCATIONS


struct Task {
    //     (meshletInfoBufferOffset, meshletCount)
    u16vec2 meshletClusterDescriptions[MESHLETS_PER_TASK_INVOCATION * MAX_PREFERRED_TASK_WORK_GROUP_INVOCATIONS + 2];
    //     (meshletDelta, LODLevel)
    u16vec2 meshletInfoBuffer[MESHLETS_PER_TASK_INVOCATION * MAX_PREFERRED_TASK_WORK_GROUP_INVOCATIONS + 2];

    uint meshletClusterDescriptionsCount;
    uint meshletInfoBufferCount;

    uint   baseMeshletID;
    uint    heightmapLength;

    float Longitude;
    float Latitude;

    vec3 observatorPosition;

    uint globalMeshletCount, localMeshletOffsetsCount;
};

taskPayloadSharedEXT Task OUT;

shared uint workgroupQuadCount;

// Used for meshlet culling
vec3 generalMeshletPosition(MeshletDescription meshlet) {
    uint heightmapIndex = meshlet.HeightmapDataOffset;

    vec2 polarOffset = localPolarOffset(meshlet.Offset);
    vec3 vertA = polarToCartesian(OUT.Latitude + polarOffset.y, OUT.Longitude + polarOffset.x, float(int(heightmapData.m_Heights[heightmapIndex])));

    return vertA;
}


shared uint meshletLODBuckets[4][MESHLETS_PER_TASK_INVOCATION * MAX_PREFERRED_TASK_WORK_GROUP_INVOCATIONS + 2];
shared uint meshletCounterPerLOD[4];

shared uint meshletCounter;
shared uint meshShaderProcessingUnitCounter;


// Core logic

void main() {
    LOD_LEVEL = 1;
    taskShaderInvocations = 0;
    meshletCounter = 0;
    meshShaderProcessingUnitCounter = 0;
    workgroupQuadCount = 0;

    OUT.heightmapLength = PushConstants.HeightmapLength;
    OUT.Longitude = PushConstants.Longitude;
    OUT.Latitude = PushConstants.Latitude;
    OUT.observatorPosition = PushConstants.ObservatorPosition;

    OUT.baseMeshletID = PushConstants.BaseMeshletOffset + MESHLETS_PER_TASK_INVOCATION * gl_WorkGroupID.x * gl_WorkGroupSize.x;

    bool ignoreThisInvocation = OUT.baseMeshletID >= PushConstants.MeshletCount;

    meshletCounterPerLOD[0] = 0;
    meshletCounterPerLOD[1] = 0;
    meshletCounterPerLOD[2] = 0;
    meshletCounterPerLOD[3] = 0;

    for(int i = 0; i<MESHLETS_PER_TASK_INVOCATION * MAX_PREFERRED_TASK_WORK_GROUP_INVOCATIONS + 2; i++){
        meshletLODBuckets[0][i] = 0;
        meshletLODBuckets[1][i] = 0;
        meshletLODBuckets[2][i] = 0;
        meshletLODBuckets[3][i] = 0;
    }


    memoryBarrierShared();
    barrier();

    atomicAdd(taskShaderInvocations, 1);


    // Pass on data

    bool addedAnything = false;

    if(!ignoreThisInvocation){
        for(uint localMeshletOffset = 0; localMeshletOffset < MESHLETS_PER_TASK_INVOCATION; localMeshletOffset++){

            bool skip = false;

            uint meshletID = OUT.baseMeshletID + MESHLETS_PER_TASK_INVOCATION * gl_LocalInvocationID.x + localMeshletOffset;


            skip = meshletID >= PushConstants.MeshletCount;


            meshletID = min(meshletID, PushConstants.MeshletCount - 1);


            MeshletDescription thisMeshlet = meshletDescriptions.descriptions[meshletID];


            // Meshlet culling
            float observerHorizonDistance = observerHorizonDistance(OUT.observatorPosition);

            bool render = !shouldCull(thisMeshlet, PushConstants.Latitude, PushConstants.Longitude, 0.0f, PushConstants.ObservatorPosition, observerHorizonDistance, PushConstants.ObserverLookingDirection); // early cull later here on meshlet

            skip = skip || !render;


            // Choose LOD level

            vec3 meshletPos = generalMeshletPosition(thisMeshlet);
            float dist = length(meshletPos - OUT.observatorPosition);

            uint lod = int(clamp(dist, 0, 800) / 250);
            LOD_LEVEL = 1 << lod;
            LOD_LEVEL = clamp(LOD_LEVEL, 1, 8);


            // Add meshlet to appropriate LOD bucket
            if(!skip){
                uint meshletOffset = atomicAdd(meshletCounterPerLOD[lod], 1);
                meshletLODBuckets[lod][meshletOffset] = uint16_t(gl_LocalInvocationID.x * MESHLETS_PER_TASK_INVOCATION + localMeshletOffset);
                addedAnything = true;
            }
        }
    }

    if(!addedAnything && (gl_LocalInvocationID.x != 0))
        return;


    memoryBarrierShared();
    barrier();



    if(gl_LocalInvocationID.x == 0 && !ignoreThisInvocation){
        atomicAdd(renderStatistics.statistics.TaskShaderInvocations, taskShaderInvocations);

        OUT.localMeshletOffsetsCount = meshletCounter;
        OUT.globalMeshletCount = PushConstants.MeshletCount;

        uint mspuCounter = 1;

        // sort the meshlet info buffer

        bool dirty = false;


        for(uint8_t lod = uint8_t(0); lod < uint8_t(4); lod++){
            for(uint16_t localMeshletDelta = uint16_t(0); localMeshletDelta < meshletCounterPerLOD[lod]; localMeshletDelta++){
                
                uint16_t meshletBufferDelta = uint16_t(atomicAdd(meshletCounter, 1));

                OUT.meshletInfoBuffer[meshletBufferDelta] = u16vec2(uint16_t(meshletLODBuckets[lod][localMeshletDelta]), uint16_t(1 << lod));


                // check if meshletCluster has the same LOD as this meshlet

                if (OUT.meshletClusterDescriptions[meshShaderProcessingUnitCounter].y != 0 &&
                    OUT.meshletInfoBuffer[OUT.meshletClusterDescriptions[meshShaderProcessingUnitCounter].x].y != (1 << lod)){

                    atomicAdd(meshShaderProcessingUnitCounter, 1);
                    mspuCounter++;
                    dirty = false;
                    OUT.meshletClusterDescriptions[meshShaderProcessingUnitCounter].x = meshletBufferDelta;
                    OUT.meshletClusterDescriptions[meshShaderProcessingUnitCounter].y = uint16_t(0);
                }

                // add the meshlet to the meshletCluster
                OUT.meshletClusterDescriptions[meshShaderProcessingUnitCounter].y++;
                dirty = true;
                
                // check if the meshletCluster is full
                // lod = 0 -> 1 = 2^0
                // lod = 1 -> 4 = 2^2
                // lod = 2 -> 16 = 2^4
                // lod = 3 -> 64 = 2^6

                if(OUT.meshletClusterDescriptions[meshShaderProcessingUnitCounter].y >= (1 << (2*lod))){
                    atomicAdd(meshShaderProcessingUnitCounter, 1);
                    mspuCounter++;
                    dirty = false;
                    OUT.meshletClusterDescriptions[meshShaderProcessingUnitCounter].x = uint16_t(meshletBufferDelta + 1);
                    OUT.meshletClusterDescriptions[meshShaderProcessingUnitCounter].y = uint16_t(0);
                }
            }
        }

        atomicAdd(meshShaderProcessingUnitCounter, int(dirty));

        if(meshShaderProcessingUnitCounter == 0)
            return;

        OUT.meshletClusterDescriptionsCount = meshShaderProcessingUnitCounter;
        OUT.meshletInfoBufferCount = meshletCounter;



        EmitMeshTasksEXT(meshShaderProcessingUnitCounter, 1, 1);
    }


}